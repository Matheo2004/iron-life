generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  password    String
  username    String
  gender      String?
  age         Int?
  height      Float?
  weight      Float?
  goal        String?   // prise de masse, perte de poids, maintien...
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions    WorkoutSession[]
  nutrition   NutritionEntry[]
  progress    Progress[]
}

model WorkoutSession {
  id          Int       @id @default(autoincrement())
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  date        DateTime  @default(now())
  duration    Int       // minutes
  type       String?
  exercises   ExerciseInSession[]
}

model Exercise {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  muscleGroup String
  description String?
  imageUrl    String?
  createdAt   DateTime  @default(now())

  sessions    ExerciseInSession[]
}

model ExerciseInSession {
  id            Int             @id @default(autoincrement())
  session       WorkoutSession  @relation(fields: [sessionId], references: [id])
  sessionId     Int
  exercise      Exercise        @relation(fields: [exerciseId], references: [id])
  exerciseId    Int
  sets          Int
  reps          Int
  weight        Float?
}

model NutritionEntry {
  id          Int       @id @default(autoincrement())
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  date        DateTime  @default(now())
  mealType    String    // petit-déjeuner, déjeuner, dîner, collation
  calories    Int
  protein     Float
  carbs       Float
  fat         Float
}

model Progress {
  id          Int       @id @default(autoincrement())
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  date        DateTime  @default(now())
  weight      Float?
  bodyFat     Float?
  muscleMass  Float?
  photoUrl    String?
}
